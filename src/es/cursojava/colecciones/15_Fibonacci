import java.util.Scanner;
public class Main
{
	public static void main (String[] args)
	{

		Scanner sc = new Scanner(System.in);
		int ultimo = 1;
		int penultimo = 1;
		int actual;
		int num;
		System.out.print("Números de la serie de Fibonacci: ");
		num = sc.nextInt();
		

		if(num <= 0)
		{
			return;
		}
		if(num == 1)
		{
			System.out.println("1");
			return;
		}
		if(num == 2)
		{
			System.out.println("1, 1");
			return;
		}
		
		System.out.print(penultimo + ", " + ultimo);

		for(int i = 0; i < num - 2; i++)
		{
			actual = ultimo + penultimo;
			System.out.print(", " + actual);
			penultimo = ultimo;
			ultimo = actual;
		}
		// Saltamos una línea
		System.out.println();
	}
}
