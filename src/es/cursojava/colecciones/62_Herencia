package conductores;

import empleado.Empleado;

public class Conductor extends Empleado
{

	private double totalKilometros;
	private String ciudadesRecorridas;

	public Conductor(String nombre, String telefono)
	{
		super(nombre, telefono);
		totalKilometros = 0;
		ciudadesRecorridas = "";
	}

	public void sumarKilometros(double kilometros)
	{
		totalKilometros += kilometros;
	}

	public double getTotalKilometros()
	{
		return totalKilometros;
	}

	public void pasaPorCiudad(String ciudad)
	{
		if(ciudadesRecorridas.length() == 0)
		{
			ciudadesRecorridas = ciudad;
		}
		else
		{
			ciudadesRecorridas += "," + ciudad;
		}
	}

	public String[] getCiudadesRecorridas()
	{
		return  ciudadesRecorridas.split(",");
	}

}

--------------------------------------------
---------------Main-----------------------------
package conductores;

public class Main
{

	public static void main(String[] args)
	{
		Conductor conductor = new Conductor("conductor", "213122");

		conductor.sumarKilometros(234.6);
		conductor.sumarKilometros(100);

		conductor.pasaPorCiudad("Madrid");
		conductor.pasaPorCiudad("Málaga");
		conductor.pasaPorCiudad("Zaragoza");

		System.out.println("Total kilómetros: " + conductor.getTotalKilometros());

		System.out.println("Ciudades recorridas:");


		for (String ciudad: conductor.getCiudadesRecorridas())
		{
			System.out.println("Nombre ciudad: " + ciudad);
		}


	}

}
