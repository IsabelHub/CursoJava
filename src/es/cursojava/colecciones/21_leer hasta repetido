
import java.util.Scanner;
public class Main2
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		// Declaración del array
		int[] numeros = new int[9];
		/* Según se va leyendo cada elemento del array		
		tenemos que mirar si ya se ha introducido */
		int aux;
		boolean repetido = false;
		// cont se inicializa al tamaño del array para el caso en el que no se mete ningún repetido,
		// y así el for final muestra el array completo.
		int cont = 0;
		while(cont < numeros.length && !repetido)
		{
			System.out.print("Número: ");
			aux = sc.nextInt();
			// Buscamos el número entre los previamente introducidos
			for(int i = 0; i < cont && !repetido; i++)
			{
				if(aux == numeros[i])
				{
					repetido = true;
				}
			}
			if(!repetido)
			{
				numeros[cont] = aux;
				cont++;
			}
		}
		// Mostramos los números introducidos
		System.out.println("Números introducidos:");
		for(int i = 0; i < cont; i++)
		{
			System.out.println(numeros[i]);
		}
	}
}
