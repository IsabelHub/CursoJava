package del.reves;

import java.util.Scanner;

public class Main
{

	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		int[] numeros = new int[10];
		for (int i = 0; i < numeros.length; i++)
		{
			System.out.print("Número: ");
			numeros[i] = sc.nextInt();
		}
		sc.close();
		int aux;
		/*
		for (int i = 0; i < numeros.length / 2; i++)
		{
			aux = numeros[i];
			numeros[i] = numeros[numeros.length - 1 - i];
			numeros[numeros.length - 1 - i] = aux;
		}
		*/

    /**
    Este bucle invierte el arreglo intercambiando los elementos del principio con los del final.

    Se usa una variable auxiliar aux para hacer el intercambio.

    i recorre desde el inicio y j desde el final, hasta encontrarse en el centro.
    */
		for (int i = 0, j = numeros.length - 1; i < numeros.length / 2; i++, j--)
		{
			aux = numeros[i];
			numeros[i] = numeros[j];
			numeros[j] = aux;
		}
		for (int i = 0; i < numeros.length; i++)
		{
			System.out.println(numeros[i]);
		}
	}

}
