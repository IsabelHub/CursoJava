package cadena.mas.larga;

import java.util.Scanner;

public class Main
{

	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		String maxLongitud = "";
		String aux;

		System.out.print("Cadena: ");
		aux = sc.nextLine();
		while(!aux.equals("fin"))
		{
			if(aux.length() >= maxLongitud.length())
			{
				maxLongitud = aux;
			}
			System.out.print("Cadena: ");
			aux = sc.nextLine();
		}
		sc.close();
		if(maxLongitud.length() == 0)
		{
			System.out.println("No se metieron cadenas.");
		}
		else
		{
			System.out.println("La cadena de mayor longitud es " + maxLongitud + ".");
		}
	}

}
