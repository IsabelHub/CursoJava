        listaColegios.add(colegio2);
        listaColegios.add(colegio3);

        // ============================================
        // 🔹 Recorrer la lista y mostrar datos
        // ============================================
        System.out.println("===== DATOS DE LOS COLEGIOS =====");
        for (Colegio col : listaColegios) {
            System.out.println("\nColegio: " + col.getNombre());
            System.out.println("Dirección: " + col.getDireccion());

            for (String nombreAula : col.getAulas().keySet()) {
                System.out.println("  Aula: " + nombreAula);

                List<Alumno> alumnos = col.getAulas().get(nombreAula);
                for (Alumno al : alumnos) {
                    System.out.println("     - " + al.getNombre() + " " + al.getApellido()
                            + " | Nota media: " + al.getNotaMedia());
                }
            }
        }

        // ============================================
        // 🔹 Buscar el colegio con mejor nota media
        // ============================================
        Colegio mejorColegio = null;
        double mejorNota = 0;

        for (Colegio col : listaColegios) {
            double media = col.calcularNotaMediaColegio();
            if (mejorColegio == null || media > mejorNota) {
                mejorColegio = col;
                mejorNota = media;
            }
        }

        System.out.println("\n===== RESULTADO =====");
        System.out.println("El colegio con la nota media más alta es: "
                + mejorColegio.getNombre() + " (" + mejorNota + ")");
    }
}
