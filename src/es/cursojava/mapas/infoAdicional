package es.cursojava.mapas;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import es.cursojava.inicio.Colegio.Alumno;

public class Colegio {

    private String nombre;
    private String direccion;
    private Map<String, List<Alumno>> aulas;

    // Constructor
    public Colegio(String nombre, String direccion) {
        this.nombre = nombre;
        this.direccion = direccion;
        this.aulas = new HashMap<>();
    }

    // Getters y Setters
    public String getNombre() {
        return nombre;
    }

    public String getDireccion() {
        return direccion;
    }

    public Map<String, List<Alumno>> getAulas() {
        return aulas;
    }

    // Método para agregar un alumno a un aula
    public void agregarAlumnoAula(String aula, Alumno alumno) {
        aulas.putIfAbsent(aula, new java.util.ArrayList<>());
        aulas.get(aula).add(alumno);
    }

    // Calcular la nota media de TODOS los alumnos del colegio
    public double calcularNotaMediaColegio() {
        int totalAlumnos = 0;
        double sumaNotas = 0;

        for (List<Alumno> alumnos : aulas.values()) {
            for (Alumno alumno : alumnos) {
                sumaNotas += alumno.getNotaMedia();
                totalAlumnos++;
            }
        }

        return totalAlumnos > 0 ? sumaNotas / totalAlumnos : 0;
    }
}


