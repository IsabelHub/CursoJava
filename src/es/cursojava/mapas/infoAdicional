package es.cursojava.mapas;

import java.util.*;
import es.cursojava.inicio.Colegio.Alumno;

public class Colegio {

    private String nombre;
    private String direccion;
    private Map<String, List<Alumno>> aulas;

    public Colegio(String nombre, String direccion) {
        this.nombre = nombre;
        this.direccion = direccion;
        this.aulas = new HashMap<>();
    }

    public String getNombre() {
        return nombre;
    }

    public String getDireccion() {
        return direccion;
    }

    public Map<String, List<Alumno>> getAulas() {
        return aulas;
    }

    // Todos los métodos que ya tenías en ColegioMayor ↓
    public void agregarAlumnoAula(String aula, Alumno alumno) {
        if (!aulas.containsKey(aula)) {
            aulas.put(aula, new ArrayList<>());
        }
        aulas.get(aula).add(alumno);
    }

    public void mostrarAlumnosPorAula() {
        for (Map.Entry<String, List<Alumno>> entrada : aulas.entrySet()) {
            String nombreAula = entrada.getKey();
            System.out.println("Aula: " + nombreAula);
            for (Alumno alumno : entrada.getValue()) {
                System.out.println("   " + alumno);
            }
        }
    }

    public double calcularNotaMediaColegio() {
        double total = 0;
        int count = 0;
        for (List<Alumno> lista : aulas.values()) {
            for (Alumno a : lista) {
                total += a.getNotaMedia();
                count++;
            }
        }
        return count > 0 ? total / count : 0;
    }
}

